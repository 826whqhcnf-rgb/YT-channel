# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values. NEVER commit .env.
# ----------------------------------------------------------------------------

# --- Visuals: Pexels (free) -------------------------------------------------
# Get a free key in 30s at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- AI script writer (recommended) -----------------------------------------
# Pick a provider and paste ONE key. Leave SCRIPT_PROVIDER blank to fall back
# to the offline placeholder generator.
#
# RECOMMENDED (free, no credit card): Groq
#   1. Get a free key at https://console.groq.com/keys
#   2. Set:  SCRIPT_PROVIDER=groq  and  SCRIPT_API_KEY=gsk_...
#
# Other supported providers (just change SCRIPT_PROVIDER + SCRIPT_API_KEY):
#   groq        free   key: https://console.groq.com/keys
#   gemini      free   key: https://aistudio.google.com/apikey
#   openrouter  free*  key: https://openrouter.ai/keys   (*free models)
#   openai      paid   key: https://platform.openai.com/api-keys
#   ollama      local  run https://ollama.com locally (no key needed)
SCRIPT_PROVIDER=
SCRIPT_API_KEY=
# Optional overrides (otherwise sensible defaults per provider are used):
SCRIPT_API_BASE=
SCRIPT_MODEL=

# --- YouTube upload (optional) ----------------------------------------------
# Path to the OAuth client secret JSON downloaded from Google Cloud Console.
# See README "YouTube setup". The token.json is created on first run.
YOUTUBE_CLIENT_SECRET=client_secret.json

# --- TikTok upload (optional) -----------------------------------------------
# From a TikTok for Developers app with the Content Posting API enabled.
# The access token is obtained via OAuth (see README "TikTok setup").
TIKTOK_ACCESS_TOKEN=

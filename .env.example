# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values. NEVER commit .env.
# ----------------------------------------------------------------------------

# --- Visuals: Pexels (free) -------------------------------------------------
# Get a free key in 30s at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Script generation (optional) -------------------------------------------
# Leave blank to use the built-in offline template generator.
# For free local generation, run Ollama (https://ollama.com) and use:
#   SCRIPT_API_BASE=http://localhost:11434/v1
#   SCRIPT_API_KEY=ollama
#   SCRIPT_MODEL=llama3.1
# For OpenAI:
#   SCRIPT_API_BASE=https://api.openai.com/v1
#   SCRIPT_API_KEY=sk-...
#   SCRIPT_MODEL=gpt-4o-mini
SCRIPT_API_BASE=
SCRIPT_API_KEY=
SCRIPT_MODEL=

# --- YouTube upload (optional) ----------------------------------------------
# Path to the OAuth client secret JSON downloaded from Google Cloud Console.
# See README "YouTube setup". The token.json is created on first run.
YOUTUBE_CLIENT_SECRET=client_secret.json

# --- TikTok upload (optional) -----------------------------------------------
# From a TikTok for Developers app with the Content Posting API enabled.
# The access token is obtained via OAuth (see README "TikTok setup").
TIKTOK_ACCESS_TOKEN=
